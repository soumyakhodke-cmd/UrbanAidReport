PORT=3000
NODE_ENV=development

# Optional: a comma-separated allowlist for separately hosted frontends.
# Leave blank when the Express server serves the site.
ALLOWED_ORIGINS=

# False-report workflow configuration.
FALSE_REPORT_POINT_DEDUCTION=25

# Citizen email notifications. Use a Google App Password, never your Gmail login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# Optional: PEM root CA file for networks that inspect/intercept outbound TLS.
# Leave blank for a direct Gmail SMTP connection.
SMTP_TLS_CA_FILE=
SMTP_USER=urbanaidreport@gmail.com
SMTP_APP_PASSWORD=
EMAIL_FROM=Urban Aid Report <urbanaidreport@gmail.com>
